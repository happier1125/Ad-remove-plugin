#!name=Turrit 外链跳转
#!desc=Telegram/Turrit 外链增强跳转
#!author=Lianolt
#!icon=https://raw.githubusercontent.com/Lianolt/Ad-remove-plugin/main/TG_Turrit/Turrit.PNG

[Script]
http-request ^https?://(www.)?(t.me|telegram.me)/.* script-path=https://raw.githubusercontent.com/Lianolt/Ad-remove-plugin/main/TG_Turrit/TG_Turrit_Loon.js,requires-body=false,timeout=10,tag=TG2Turrit
