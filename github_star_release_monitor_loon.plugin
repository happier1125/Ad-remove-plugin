#!name=GitHub Star Release 监控
#!desc=每小时检查 GitHub Star 仓库是否发布新 Release
#!author=Lianolt
#!homepage=https://github.com/happier1125/Ad-remove-plugin/blob/main/github_star_release_monitor_loon.plugin

[Script]
cron "0 * * * *" script-path=github_star_release_monitor_loon.js, timeout=300, tag=GitHub Star Release 监控, enabled=true
