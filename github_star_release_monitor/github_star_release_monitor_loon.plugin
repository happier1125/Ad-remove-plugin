#!name=GitHub Star Release 监控
#!desc=每小时检查 GitHub Star 仓库是否发布新 Release，可在插件页面填写 GitHub Token
#!author=Lianolt
#!homepage=https://github.com/Lianolt/Ad-remove-plugin/blob/main/github_star_release_monitor/github_star_release_monitor_loon.plugin

[Argument]
github_token = input,"",tag=GitHub Token,desc=填写 GitHub Token。建议仅授予 Starring Read-only 权限。

[Script]
cron "0 * * * *" script-path=github_star_release_monitor_loon.js, timeout=300, tag=GitHub Star Release 监控, enabled=true, argument=[{github_token}]
